# ==============================================================================
# Frontend (Flutter / Dart / Android / iOS)
# ==============================================================================
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/coverage/
